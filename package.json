{
  "name": "pi",
  "displayName": "Pi",
  "description": "Pi Agent 插件：把本机安装的 Pi coding agent 以 RPC 模式接入 Coda，支持会话指令、模型与推理强度选择、插话和会话恢复。",
  "version": "0.3.1",
  "contributes": {
    "agents": [
      {
        "id": "pi",
        "displayName": "Pi",
        "icon": {
          "light": "icons/pi.pdf"
        },
        "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/agent/entry.mjs\"",
        "modes": {
          "title": "工作模式",
          "note": "Pi 没有审批模式，工具按 Pi 自己的配置执行。"
        },
        "skillsDir": ".agents/skills",
        "configFiles": [
          "${PI_CODING_AGENT_DIR:-~/.pi/agent}/settings.json",
          "${PI_CODING_AGENT_DIR:-~/.pi/agent}/models.json"
        ],
        "setupHint": "插件会自动安装 Pi；装不上时在插件页重试准备运行环境，或自己安装 `npm i -g @earendil-works/pi-coding-agent`。再在 Coda 里添加 provider，或在 pi 里登录"
      }
    ],
    "configuration": {
      "properties": {
        "pi.commandPath": {
          "type": "string",
          "default": "pi",
          "description": "pi 可执行文件的路径；留为 pi 时使用 PATH 和常见安装目录。",
          "order": 1
        },
        "pi.extraArgs": {
          "type": "string",
          "default": "",
          "description": "追加到 pi --mode rpc 的额外参数，按空白分隔。",
          "order": 2
        },
        "pi.providers": {
          "type": "object",
          "title": "Provider",
          "order": 3,
          "description": "一行一个 provider，行名是 Pi 里的 provider 名（不带 /）。选一个插件提供的模型服务，或自己填地址和 Key；模型从「地址/models」列出，在 Coda 点「重新读取模型」即刷新。",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "format": "coda-model-provider",
                "title": "来源",
                "order": 0,
                "description": "选别的插件提供的模型服务（如 CLIProxy）；选了就不用填地址和 Key"
              },
              "url": {
                "type": "string",
                "format": "coda-model-url",
                "modelKey": "key",
                "modelApi": "api",
                "title": "地址",
                "order": 1,
                "description": "OpenAI 兼容的 API 地址，如 https://example.com/v1"
              },
              "key": {
                "type": "string",
                "writeOnly": true,
                "title": "Key",
                "order": 2
              },
              "api": {
                "type": "string",
                "title": "协议",
                "order": 3,
                "enum": [
                  "openai-completions",
                  "openai-responses",
                  "anthropic-messages"
                ],
                "default": "openai-completions"
              },
              "reasoning": {
                "type": "boolean",
                "title": "推理",
                "order": 4,
                "default": true
              },
              "contextWindow": {
                "type": "integer",
                "title": "上下文长度",
                "order": 5,
                "minimum": 1,
                "default": 128000
              },
              "maxTokens": {
                "type": "integer",
                "title": "最大输出",
                "order": 6,
                "minimum": 1,
                "default": 16384
              }
            }
          }
        }
      }
    },
    "setup": {
      "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/agent/setup.mjs\""
    }
  }
}
