{
  "name": "@coda-console/pi",
  "id": "pi",
  "displayName": "Pi",
  "description": "Pi Agent 插件：随插件提供并锁定 Pi coding agent，以 RPC 模式接入 Coda，支持会话指令、模型与推理强度选择、插话和会话恢复。",
  "version": "0.5.0",
  "categories": [
    "Agent"
  ],
  "contributes": {
    "agents": [
      {
        "id": "pi",
        "displayName": "Pi",
        "icon": {
          "light": "icons/pi.pdf"
        },
        "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/agent/entry.mjs\"",
        "modes": {
          "title": "工作模式",
          "note": "Pi 没有审批模式，工具按 Pi 自己的配置执行。"
        },
        "skillsDir": ".agents/skills",
        "configFiles": [
          "${PI_CODING_AGENT_DIR:-~/.pi/agent}/settings.json",
          "${PI_CODING_AGENT_DIR:-~/.pi/agent}/models.json"
        ],
        "setupHint": "Pi 运行时随本插件安装和更新。请在插件页检查 Pi 插件更新；装不上时重试准备运行环境。再在 Coda 里添加 provider，或在 pi 里登录"
      }
    ],
    "configuration": {
      "properties": {
        "pi.commandPath": {
          "type": "string",
          "default": "pi",
          "description": "留为 pi 时使用随插件安装并锁定的 Pi；填绝对路径可使用你自己管理的 Pi。显式路径不会被 PATH 或插件更新自动替换。",
          "order": 1
        },
        "pi.extraArgs": {
          "type": "string",
          "default": "",
          "description": "追加到 pi --mode rpc 的额外参数，按空白分隔。",
          "order": 2
        },
        "pi.providers": {
          "type": "object",
          "title": "Provider",
          "order": 3,
          "description": "一行一个 provider，行名是 Pi 里的 provider 名（不带 /）。选一个插件提供的模型服务，或自己填地址和 Key；模型从「地址/models」列出，在 Coda 点「重新读取模型」即刷新。",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "format": "coda-model-provider",
                "title": "来源",
                "order": 0,
                "description": "选别的插件提供的模型服务（如 CLIProxy）；选了就不用填地址和 Key"
              },
              "url": {
                "type": "string",
                "format": "coda-model-url",
                "modelKey": "key",
                "modelApi": "api",
                "title": "地址",
                "order": 1,
                "description": "OpenAI 兼容的 API 地址，如 https://example.com/v1"
              },
              "key": {
                "type": "string",
                "writeOnly": true,
                "title": "Key",
                "order": 2
              },
              "api": {
                "type": "string",
                "title": "协议",
                "order": 3,
                "enum": [
                  "openai-completions",
                  "openai-responses",
                  "anthropic-messages"
                ],
                "default": "openai-completions"
              },
              "reasoning": {
                "type": "boolean",
                "title": "推理",
                "order": 4,
                "default": true
              },
              "contextWindow": {
                "type": "integer",
                "title": "上下文长度",
                "order": 5,
                "minimum": 1,
                "default": 128000
              },
              "maxTokens": {
                "type": "integer",
                "title": "最大输出",
                "order": 6,
                "minimum": 1,
                "default": 16384
              }
            }
          }
        }
      }
    },
    "setup": {
      "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/agent/setup.mjs\""
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sealiu1997/coda_plugins_pi_agent.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "agent",
    "icons"
  ],
  "devDependencies": {
    "@coda-console/plugin-check": "0.5.8"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check:coda": "coda-plugin-check . --manifest && node scripts/check-fake-live.mjs --handshake",
    "check:pi": "node scripts/check-pi-compat.mjs",
    "check:pi:verified": "node scripts/check-pi-compat.mjs",
    "check:fake-live": "node scripts/check-fake-live.mjs",
    "check:real-live": "coda-plugin-check . --live",
    "probe:upstream": "node scripts/probe-upstream.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0"
  }
}
